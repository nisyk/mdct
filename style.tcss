Screen {
    &:inline {
        border: none;
        height: 12;
    }
}

#track-info, #artist-info {
    width: 100%;
    height: auto;
    text-align: center;
}

#track-info {
    margin-top: 1;
    color: $primary;
    text-style: bold;
}

#artist-info {
    margin-bottom: 1;
}



#media-control {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 1 2;
}
#media-control Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
    margin-right: 1;

}

#media-control #btn-play {
    width: auto;
    min-width: 12;

}

#progress Bar > .bar--bar {
    color: $success;
    background: $success 30%;
}
#progress {
    width: 100%;
    height: auto;
    align: center middle;
}

#track-progress {
    opacity: 50%
}




